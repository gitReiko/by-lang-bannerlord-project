<?xml version="1.0" encoding="utf-8"?>
<base xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:xsd="http://www.w3.org/2001/XMLSchema" type="string">



  <strings>
    <!--taom_messenger_strings.xml-->
    <string id="taom_messenger_already_sent" text="Ганец ужо высланы да гэтай асобы." />
    <string id="taom_messenger_arrived" text="Прыбыў ганец. Адпраўнік — {HERO_NAME}. Хочаце пагаварыць?" />
    <string id="taom_messenger_arrived_title" text="Ганец Прыбыў" />
    <string id="taom_messenger_cannot_send" text="Немагчыма Паслаць Ганца" />
    <string id="taom_messenger_confused" text="Ганец выглядае разгубленым — ён спрабаваў знайсьці кагосьці ў вашай жа партыі!" />
    <string id="taom_messenger_dialog_decline" text="Пасьля роздуму, ня трэба." />
    <string id="taom_messenger_dialog_decline_ack" text="Як скажаце." />
    <string id="taom_messenger_dialog_init" text="Магчыма, пазьней мне спатрэбіцца даслаць вам паведамленьне. Ці магу я паслаць да вас ганца?" />
    <string id="taom_messenger_dialog_npc_accept" text="Вядома. Я абавязкова прыму вашага ганца, калі ён прыбудзе." />
    <string id="taom_messenger_dialog_send" text="Паслаць ганца ({COST} дэнараў)" />
    <string id="taom_messenger_dialog_sent" text="Тады буду чакаць вашага ганца." />
    <string id="taom_messenger_disabled" text="Сыстэма ганцоў выключаная ў наладах." />
    <string id="taom_messenger_dismiss" text="Адпусьціць" />
    <string id="taom_messenger_error" text="Памылка Ганца" />
    <string id="taom_messenger_hero_child" text="{HERO_NAME}: узрост яшчэ замалы для прыёму ганцоў." />
    <string id="taom_messenger_hero_dead" text="{HERO_NAME}: ужо няма сярод жывых." />
    <string id="taom_messenger_hero_fugitive" text="{HERO_NAME}: ва ўцёках, знайсьці немагчыма." />
    <string id="taom_messenger_hero_prisoner" text="{HERO_NAME}: у зьняволеньні, прыём ганцоў немагчымы." />
    <string id="taom_messenger_invalid_target" text="Няправільны адрасат." />
    <string id="taom_messenger_lost" text="Ваш ганец трапіў у разбойніцкую засаду і не дайшоў. Адрасат — {HERO_NAME}." />
    <string id="taom_messenger_lost_title" text="Ганец Зьнік" />
    <string id="taom_messenger_no_gold" text="Не хапае золата! Вам трэба {COST} дэнараў." />
    <string id="taom_messenger_not_available" text="Сыстэма ганцоў недаступная." />
    <string id="taom_messenger_recipient_gone" text="Ваш ганец вярнуўся, не перадаўшы паведамленьня. Адрасат — {HERO_NAME}; зьвязацца зь ім больш немагчыма." />
    <string id="taom_messenger_sent" text="Ганец высланы. Адрасат — {HERO_NAME}; тэрмін прыбыцьця — цягам {DAYS} дзён." />
    <string id="taom_messenger_sent_title" text="Ганец Высланы" />
    <string id="taom_messenger_speak" text="Пагаварыць" />
    <string id="taom_messenger_target_unavailable" text="Цяпер з гэтай асобай нельга зьвязацца праз ганца." />
    <string id="taom_send_messenger" text="Паслаць ганца" />
  </strings>
</base>
