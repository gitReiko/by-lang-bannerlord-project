  <strings>
    <string id="taom_career_abanissa_house_guard" text="House-Guard of Damudûr" />
    <string id="taom_career_abanissa_house_guard_desc" text="A warrior of the Damudûr desert tribes whose attrition-warfare tactics grind enemies down with relentless pressure and poisoned blades." />
    <string id="taom_career_abanissa_ivory_rider" text="Ivory-Road Beast Rider" />
    <string id="taom_career_abanissa_ivory_rider_desc" text="A fearsome rider of the Far Harad who drives great beasts into the enemy, breaking lines with shock and primal terror." />
    <string id="taom_career_abanissa_jiret_javelineer" text="Jîret Javelineer" />
    <string id="taom_career_abanissa_jiret_javelineer_desc" text="A fast-moving skirmisher of Jîret who screens cavalry with a hail of javelins before withdrawing beyond reach of retaliation." />
    <string id="taom_career_avanc_luth_raider" text="Dunlending Champion" />
    <string id="taom_career_avanc_luth_raider_desc" text="A blood-painted skirmisher of the Avanc-lúth clan who charges into melee with reckless aggression, trading surgical precision for raw savage force that overwhelms opponents through sheer relentless pressure." />
    <string id="taom_career_balchoth_kan" text="Balchoth Kân" />
    <string id="taom_career_balchoth_kan_desc" text="A heavy cavalry commander of the Balchoth who leads unstoppable mounted charges, maintaining iron morale no matter the odds." />
    <string id="taom_career_black_uruk_captain" text="Black Uruk Captain" />
    <string id="taom_career_black_uruk_captain_desc" text="An iron-muscled champion of Mordor who leads Black Uruk warbands into the breach, absorbing punishment that would fell lesser warriors and turning the tide through sheer brutish dominance." />
    <string id="taom_career_blade_dancer" text="Ñoldor Blademaster" />
    <string id="taom_career_blade_dancer_desc" text="A graceful elven warrior who weaves through battle like flowing water, striking with ancient blades forged in the First Age." />
    <string id="taom_career_blademaster_of_ren" text="Blademaster of Rên" />
    <string id="taom_career_blademaster_of_ren_desc" text="A precision duelist from the warrior-courts of Rên who dispatches enemies with calculated, lethal blade work." />
    <string id="taom_career_captain_of_osgiliath" text="Captain of Osgiliath" />
    <string id="taom_career_captain_of_osgiliath_desc" text="A battle-hardened infantry officer who commands Gondor&apos;s frontline defense at the ruins of Osgiliath, forging order from chaos in brutal urban combat. The Captain holds the line where others would break, rallying soldiers through sheer force of will." />
    <string id="taom_career_cave_troll_master" text="Gundabad Berserker" />
    <string id="taom_career_cave_troll_master_desc" text="A brutal orc chieftain of Gundabad who commands cave trolls in battle, driving them forward with whip and cunning." />
    <string id="taom_career_chariot_warlord" text="Chariot Warlord" />
    <string id="taom_career_chariot_warlord_desc" text="A scythe-chariot commander of Khand whose brutal shock charges shatter formations and scatter survivors to the winds." />
    <string id="taom_career_clanguard_rider" text="Dunlending Outrider" />
    <string id="taom_career_clanguard_rider_desc" text="A fast-raiding clan cavalryman who harasses enemy flanks with swift hit-and-run assaults, using superior speed and pack coordination to disrupt formations before the clan&apos;s infantry close in for the kill." />
    <string id="taom_career_codyan_legionaire" text="Côdyan Legionaire" />
    <string id="taom_career_codyan_legionaire_desc" text="A disciplined shieldwall soldier of the Côdya formations who excels in defensive cohesion, soaking punishment while the line holds firm." />
    <string id="taom_career_corsair_boarder" text="Corsair Boarder" />
    <string id="taom_career_corsair_boarder_desc" text="A cutlass-wielding sea reaver who storms enemy decks with ruthless ferocity, taking what the Corsairs desire." />
    <string id="taom_career_corsair_captain" text="Corsair Captain" />
    <string id="taom_career_corsair_captain_desc" text="A seasoned fleet commander who leads from the prow, inspiring crews with promises of plunder and glory on the high seas." />
    <string id="taom_career_corsair_crossbow" text="Corsair Crossbow" />
    <string id="taom_career_corsair_crossbow_desc" text="A sharpshooter of the Corsair fleet who picks off helmsmen and officers from the rigging with deadly accuracy." />
    <string id="taom_career_craig_crag_stalker" text="Blue Craig Crag Stalker" />
    <string id="taom_career_craig_crag_stalker_desc" text="A spiteful goblin marksman who lurks in the mountain crags, picking off targets with poisoned darts and crude bows." />
    <string id="taom_career_craig_pit_driver" text="Blue Craig Pit-Driver" />
    <string id="taom_career_craig_pit_driver_desc" text="A brutal orc chieftain of Blue Craig who commands cave trolls in battle, driving them forward with whip and cunning." />
    <string id="taom_career_craig_warg_master" text="Blue Craig Warg Master" />
    <string id="taom_career_craig_warg_master_desc" text="A feared orc alpha who rides the largest warg of the pack, leading savage hunts through the Ered Luin." />
    <string id="taom_career_crossbow_master" text="Crossbow Master" />
    <string id="taom_career_crossbow_master_desc" text="A dwarven engineer-warrior who wields masterwork crossbows of incredible stopping power, each bolt precision-crafted." />
    <string id="taom_career_dale_guardsman" text="Dalian Master Swordsman" />
    <string id="taom_career_dale_guardsman_desc" text="A stalwart protector of the rebuilt city of Dale who holds the gate against all comers with shield and spear." />
    <string id="taom_career_dale_marksman" text="Barding Marksman" />
    <string id="taom_career_dale_marksman_desc" text="A legendary bowman of Dale whose ancestors slew Smaug, carrying on the tradition of unerring marksmanship." />
    <string id="taom_career_dale_outrider" text="Dalian Cavalier" />
    <string id="taom_career_dale_outrider_desc" text="A mounted patrol of the northern trade roads who safeguards caravans between Dale and the Lonely Mountain." />
    <string id="taom_career_elk_rider" text="Elk Rider" />
    <string id="taom_career_elk_rider_desc" text="A mounted warrior of Thranduil&apos;s guard who rides great forest elk into battle, crashing through underbrush and foe alike." />
    <string id="taom_career_elven_archer" text="Ñoldor Sentinel" />
    <string id="taom_career_elven_archer_desc" text="A peerless marksman of Imladris whose arrows fly true across vast distances, guided by centuries of practice." />
    <string id="taom_career_eotheod_windrider" text="Eothéod Windrider" />
    <string id="taom_career_eotheod_windrider_desc" text="A descendant of the ancient Eothéod horsemasters who rides with the thunder of generations of legend, inspiring allies with a warcry that echoes Eorl the Young and scattering enemies under hooves of unstoppable heavy cavalry." />
    <string id="taom_career_falathrim_blade_dancer" text="Falathrim Blade-Dancer" />
    <string id="taom_career_falathrim_blade_dancer_desc" text="A graceful elven warrior who weaves through battle like flowing water, striking with ancient blades forged in the First Age." />
    <string id="taom_career_falathrim_mariner" text="Falathrim Mariner" />
    <string id="taom_career_falathrim_mariner_desc" text="A mounted warrior of Cirdan&apos;s household who rides to war on swift elven steeds, a beacon of hope against the shadow." />
    <string id="taom_career_falathrim_sentinel" text="Falathrim Sentinel" />
    <string id="taom_career_falathrim_sentinel_desc" text="A peerless marksman of Mithlond whose arrows fly true across vast distances, guided by centuries of practice." />
    <string id="taom_career_fell_rider" text="Fell Rider" />
    <string id="taom_career_fell_rider_desc" text="A dread horseman of the shadow host who spreads fear with every charge, their mount wreathed in dark mist." />
    <string id="taom_career_galadhrim_archer" text="Galadhrim Archer" />
    <string id="taom_career_galadhrim_archer_desc" text="An elite bowman of Lothlorien who rains silver arrows from the mallorn canopy, each shot guided by the light of Galadriel." />
    <string id="taom_career_goblin_sniper" text="Gundabad Orc Hunter" />
    <string id="taom_career_goblin_sniper_desc" text="A spiteful goblin marksman who lurks in the mountain crags, picking off targets with poisoned darts and crude bows." />
    <string id="taom_career_goblin_troll_driver" text="Goblin-town Troll-Driver" />
    <string id="taom_career_goblin_troll_driver_desc" text="A brutal orc chieftain of Goblin-town who commands cave trolls in battle, driving them forward with whip and cunning." />
    <string id="taom_career_goblin_tunnel_stalker" text="Goblin-town Tunnel Stalker" />
    <string id="taom_career_goblin_tunnel_stalker_desc" text="A spiteful goblin marksman who lurks in the mountain crags, picking off targets with poisoned darts and crude bows." />
    <string id="taom_career_goblin_warg_master" text="Goblin-town Warg Master" />
    <string id="taom_career_goblin_warg_master_desc" text="A feared orc alpha who rides the largest warg of the pack, leading savage hunts through the Misty Mountains." />
    <string id="taom_career_ironguard" text="Ironguard" />
    <string id="taom_career_ironguard_desc" text="An elite dwarven warrior clad in mithril-forged plate who holds the deeps of Erebor against orc and dragon alike." />
    <string id="taom_career_knight_of_belfalas" text="Knight of Belfalas" />
    <string id="taom_career_knight_of_belfalas_desc" text="An armored champion of the coastal fiefdom of Belfalas, whose thundering charge has broken countless enemy formations. The Knight of Belfalas combines Gondorian discipline with Dol Amroth&apos;s proud cavalry tradition, becoming an immovable wall of steel." />
    <string id="taom_career_lokhas_drus_marksman" text="Lôkhas Drûs Marksman" />
    <string id="taom_career_lokhas_drus_marksman_desc" text="An armor-piercing specialist of the Lôkhas Drûs corps who trains to drive arrows through the heaviest plate at range." />
    <string id="taom_career_mahud_beast_rider" text="Mahûd Beast Rider" />
    <string id="taom_career_mahud_beast_rider_desc" text="A fearsome rider of the Far Harad who drives great beasts into the enemy, breaking lines with shock and primal terror." />
    <string id="taom_career_marksman_of_aldburg" text="Marksman of Aldburg" />
    <string id="taom_career_marksman_of_aldburg_desc" text="A heavy archer of the Aldburg garrison who has mastered the art of loosing light, high-velocity arrows with lethal precision, capable of penetrating armour at distances that leave enemies no safe quarter." />
    <string id="taom_career_misty_deep_marksman" text="Moria Deep-Marksman" />
    <string id="taom_career_misty_deep_marksman_desc" text="A spiteful goblin marksman who lurks in the mountain crags, picking off targets with poisoned darts and crude bows." />
    <string id="taom_career_misty_troll_goad" text="Moria Troll-Goad" />
    <string id="taom_career_misty_troll_goad_desc" text="A brutal orc chieftain of Moria who commands cave trolls in battle, driving them forward with whip and cunning." />
    <string id="taom_career_misty_warg_chieftain" text="Misty Mountain Warg Chieftain" />
    <string id="taom_career_misty_warg_chieftain_desc" text="A feared orc alpha who rides the largest warg of the pack, leading savage hunts through the Misty Mountains." />
    <string id="taom_career_mulkerhili_cultist" text="Mulkerhílí Cultist" />
    <string id="taom_career_mulkerhili_cultist_desc" text="A fanatical devotee of the One Ring&apos;s whispered promises who channels the terror of Sauron&apos;s voice to shatter enemy resolve, blending cursed archery with a maddening presence that erodes the will to fight." />
    <string id="taom_career_necromancer_acolyte" text="Necromancer Acolyte" />
    <string id="taom_career_necromancer_acolyte_desc" text="A fell sorcerer who channels dark energies to weaken enemies from afar, sowing terror and decay across the battlefield." />
    <string id="taom_career_olog_hai_warchief" text="Olog-Hai Warchief" />
    <string id="taom_career_olog_hai_warchief_desc" text="A towering Olog-Hai war-troll who wades into the thickest fighting as a living battering ram, soaking up tremendous punishment and hammering foes into the ground with devastating overhead blows." />
    <string id="taom_career_pezarsani_javelineer" text="Pezarsani Javelineer" />
