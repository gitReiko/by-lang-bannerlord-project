    <string id="taom_career_sentinel" text="Sentinel of the Golden Wood" />
    <string id="taom_career_sentinel_desc" text="A mounted guardian who patrols the borders of Lorien, riding swift and silent under the golden eaves." />
    <string id="taom_career_shadow_walker" text="Shadow Walker" />
    <string id="taom_career_shadow_walker_desc" text="A woodland elf who moves unseen through the darkened paths of Mirkwood, dispatching spiders and orcs in silence." />
    <string id="taom_career_shadow_warrior" text="Shadow Warrior" />
    <string id="taom_career_shadow_warrior_desc" text="A dark champion of Dol Guldur empowered by the Necromancer&apos;s sorcery, draining the life of all who stand before them." />
    <string id="taom_career_shaghana_beast_rider" text="Sormedân Beast Rider" />
    <string id="taom_career_shaghana_beast_rider_desc" text="A fearsome rider of the Far Harad who drives great beasts into the enemy, breaking lines with shock and primal terror." />
    <string id="taom_career_shaghana_chatak_javelineer" text="Chatâk Javelineer" />
    <string id="taom_career_shaghana_chatak_javelineer_desc" text="A fast-moving skirmisher of Chatâk who screens cavalry with a hail of javelins before withdrawing beyond reach of retaliation." />
    <string id="taom_career_shaghana_zajana_tribesman" text="Tribesman of Zajâna" />
    <string id="taom_career_shaghana_zajana_tribesman_desc" text="A warrior of the Zajâna desert tribes whose attrition-warfare tactics grind enemies down with relentless pressure and poisoned blades." />
    <string id="taom_career_silvan_archer" text="Silvan Archer" />
    <string id="taom_career_silvan_archer_desc" text="A keen-eyed hunter of the Woodland Realm who strikes from the treetops with lethal precision." />
    <string id="taom_career_snaga_rider" text="Snaga Rider" />
    <string id="taom_career_snaga_rider_desc" text="A wiry Snaga cavalry raider who slips behind enemy lines with unnerving silence, striking supply columns and isolated units before vanishing into the smoke of Mordor." />
    <string id="taom_career_steppe_bowmaster" text="Steppe Bowmaster" />
    <string id="taom_career_steppe_bowmaster_desc" text="A mobile archer of the Khand plains who harasses enemy lines with relentless volleys, never standing still long enough to be caught." />
    <string id="taom_career_tribesman_of_jelut" text="Tribesman of Jelut" />
    <string id="taom_career_tribesman_of_jelut_desc" text="A warrior of the Jelut desert tribes whose attrition-warfare tactics grind enemies down with relentless pressure and poisoned blades." />
    <string id="taom_career_uruk_berserker" text="Uruk-Hai Berserker" />
    <string id="taom_career_uruk_berserker_desc" text="A frenzied Uruk-hai who charges headlong into battle, growing stronger as wounds fuel an unstoppable rage." />
    <string id="taom_career_uruk_crossbow" text="Uruk-Hai Crossbowman" />
    <string id="taom_career_uruk_crossbow_desc" text="A disciplined Uruk marksman wielding Saruman&apos;s iron crossbows, delivering devastating volleys from Orthanc&apos;s forges." />
    <string id="taom_career_warden" text="Warden of Lorien" />
    <string id="taom_career_warden_desc" text="A silent guardian of the Golden Wood who strikes without warning, defending the borders of Lothlorien with ancient resolve." />
    <string id="taom_career_warg_pack_leader" text="Gundabad Fell Warg Pack Leader" />
    <string id="taom_career_warg_pack_leader_desc" text="A feared orc alpha who rides the largest warg of the pack, leading savage hunts through the Misty Mountains." />
    <string id="taom_career_warg_scout" text="Warg Rider" />
    <string id="taom_career_warg_scout_desc" text="A cunning Uruk rider mounted on a swift warg, scouting ahead of the armies of Isengard and running down fleeing prey." />
    <string id="taom_career_watchman_of_stangard" text="Watchman of Stangard" />
    <string id="taom_career_watchman_of_stangard_desc" text="A grizzled river-warden of Stangard who patrols the Anduin crossings by flatboat and on foot, guarding Rohan&apos;s eastern flank through endurance, local knowledge, and a boatswain&apos;s tenacious grip on contested ground." />
    <string id="taom_career_wolfskin_hunter" text="Dunlending Archer" />
    <string id="taom_career_wolfskin_hunter_desc" text="A patient stalker who dresses in wolf-pelts and moves through the Misty Mountain foothills like a ghost, marking prey from concealment before unleashing a precisely aimed shaft that the victim never hears coming." />
