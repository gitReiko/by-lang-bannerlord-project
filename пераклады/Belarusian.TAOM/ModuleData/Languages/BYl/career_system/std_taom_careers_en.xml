    <string id="taom_career_ram_rider" text="Ram Rider" />
    <string id="taom_career_ram_rider_desc" text="A dwarven cavalry warrior mounted on a great war-ram, charging through tight mountain passes where horses cannot tread." />
    <string id="taom_career_ranger_of_ithilien" text="Ranger of Ithilien" />
    <string id="taom_career_ranger_of_ithilien_desc" text="An elite scout who strikes from the shadows of Ithilien, ambushing enemies of Gondor with deadly precision." />
