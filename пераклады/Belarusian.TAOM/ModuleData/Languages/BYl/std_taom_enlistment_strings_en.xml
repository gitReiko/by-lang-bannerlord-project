  <strings>
    <string id="taom_enlist_act_battle" text="{COMMANDER} is engaged. Hold your place in the line." />
    <string id="taom_enlist_act_lost" text="You have lost the column. Await word of your commander." />
    <string id="taom_enlist_act_march" text="You march with {COMMANDER}&apos;s company, at your commander&apos;s pace." />
    <string id="taom_enlist_act_settlement" text="The column rests inside {SETTLEMENT}." />
    <string id="taom_enlist_act_siege" text="You are camped before the walls with {COMMANDER}&apos;s company." />
    <string id="taom_enlist_already_serving" text="You are bound to military service." />
    <string id="taom_enlist_arrival_body" text="Your company has stopped at {SETTLEMENT}. Your sergeant will look the other way if you want a few hours to yourself." />
    <string id="taom_enlist_arrival_stay" text="Stay with the company" />
    <string id="taom_enlist_arrival_take" text="Take your leave" />
    <string id="taom_enlist_arrival_title" text="The column halts" />
    <string id="taom_enlist_board_arrears" text="{NEWLINE}Pay owed to you: {GOLD}{GOLD_ICON}" />
    <string id="taom_enlist_board_duty" text="{NEWLINE}You have orders: {DUTY_NAME}" />
    <string id="taom_enlist_board_ladder" text="{NEWLINE}Toward {NEXT_RANK}: {REQUIREMENT}" />
    <string id="taom_enlist_discharge" text="I ask to be released from your service." />
    <string id="taom_enlist_discharge_answer" text="You have marched well enough. Go, then — you are released." />
    <string id="taom_enlist_duty_already" text="You already have your orders. See them done first." />
    <string id="taom_enlist_duty_assigned" text="You are given orders: {DUTY}." />
    <string id="taom_enlist_duty_bandit_hunt_failure" text="You find the camp abandoned, warm — they were warned." />
    <string id="taom_enlist_duty_bandit_hunt_success" text="The camp is cold ash by the time you leave it." />
    <string id="taom_enlist_duty_bandit_hunt_title" text="a bandit hunt" />
    <string id="taom_enlist_duty_camp_discipline_body" text="A shouting match is drawing a crowd before it turns into something worse." />
    <string id="taom_enlist_duty_camp_discipline_failure" text="It didn&apos;t go as planned." />
    <string id="taom_enlist_duty_camp_discipline_opta" text="Break It Up" />
    <string id="taom_enlist_duty_camp_discipline_optb" text="Fetch Sergeant" />
    <string id="taom_enlist_duty_camp_discipline_success" text="It went well." />
    <string id="taom_enlist_duty_camp_discipline_title" text="Trouble in Camp" />
    <string id="taom_enlist_duty_command_squad_body" text="A squad needs a steady hand to drill and ready them for the line." />
    <string id="taom_enlist_duty_command_squad_failure" text="It didn&apos;t go as planned." />
    <string id="taom_enlist_duty_command_squad_opta" text="Drill Maneuver" />
    <string id="taom_enlist_duty_command_squad_optb" text="Inspect Kit" />
    <string id="taom_enlist_duty_command_squad_success" text="It went well." />
    <string id="taom_enlist_duty_command_squad_title" text="Command a Squad" />
    <string id="taom_enlist_duty_coordinate_supply_body" text="The wagons are backed up and someone needs to get them moving again." />
    <string id="taom_enlist_duty_coordinate_supply_failure" text="It didn&apos;t go as planned." />
    <string id="taom_enlist_duty_coordinate_supply_opta" text="Route Wagons" />
    <string id="taom_enlist_duty_coordinate_supply_optb" text="Hire Carters" />
    <string id="taom_enlist_duty_coordinate_supply_success" text="It went well." />
    <string id="taom_enlist_duty_coordinate_supply_title" text="Supply Lines" />
    <string id="taom_enlist_duty_deserter_sweep_failure" text="They know the country better than you do, and use it." />
    <string id="taom_enlist_duty_deserter_sweep_success" text="You bring them back to the column. Most of them walking." />
    <string id="taom_enlist_duty_deserter_sweep_title" text="a sweep for deserters" />
    <string id="taom_enlist_duty_equipment_check_body" text="The quartermaster wants every soldier&apos;s kit checked before the muster." />
    <string id="taom_enlist_duty_equipment_check_failure" text="It didn&apos;t go as planned." />
    <string id="taom_enlist_duty_equipment_check_opta" text="Full Inventory" />
    <string id="taom_enlist_duty_equipment_check_optb" text="Spot Repairs" />
    <string id="taom_enlist_duty_equipment_check_success" text="It went well." />
    <string id="taom_enlist_duty_equipment_check_title" text="Kit Inspection" />
    <string id="taom_enlist_duty_forage_failure" text="The country has been picked over, and recently." />
    <string id="taom_enlist_duty_forage_success" text="You come back heavier than you left." />
    <string id="taom_enlist_duty_forage_title" text="to forage for the company" />
    <string id="taom_enlist_duty_gate_watch_body" text="The gate needs a steady pair of eyes on who comes and goes." />
    <string id="taom_enlist_duty_gate_watch_failure" text="It didn&apos;t go as planned." />
    <string id="taom_enlist_duty_gate_watch_opta" text="Check Papers" />
    <string id="taom_enlist_duty_gate_watch_optb" text="Lean Wall" />
    <string id="taom_enlist_duty_gate_watch_success" text="It went well." />
    <string id="taom_enlist_duty_gate_watch_title" text="Gate Duty" />
    <string id="taom_enlist_duty_hideout_strike_failure" text="The approach goes wrong early and you pull back with what you brought." />
    <string id="taom_enlist_duty_hideout_strike_success" text="They never formed up. It was over in the dark." />
    <string id="taom_enlist_duty_hideout_strike_title" text="to strike a hideout" />
    <string id="taom_enlist_duty_inspect_defenses_body" text="Someone needs to walk the defenses and report back on their condition." />
    <string id="taom_enlist_duty_inspect_defenses_failure" text="It didn&apos;t go as planned." />
    <string id="taom_enlist_duty_inspect_defenses_opta" text="Walk Works" />
    <string id="taom_enlist_duty_inspect_defenses_optb" text="Count Stores" />
    <string id="taom_enlist_duty_inspect_defenses_success" text="It went well." />
    <string id="taom_enlist_duty_inspect_defenses_title" text="Walk the Works" />
    <string id="taom_enlist_duty_lead_patrol_body" text="The next patrol needs someone to lead it out and bring it back whole." />
    <string id="taom_enlist_duty_lead_patrol_failure" text="It didn&apos;t go as planned." />
    <string id="taom_enlist_duty_lead_patrol_opta" text="Take Point" />
    <string id="taom_enlist_duty_lead_patrol_optb" text="Delegate Route" />
    <string id="taom_enlist_duty_lead_patrol_success" text="It went well." />
    <string id="taom_enlist_duty_lead_patrol_title" text="Take the Patrol" />
    <string id="taom_enlist_duty_mounted_pursuit_failure" text="They scatter into broken country and the horses will not follow." />
    <string id="taom_enlist_duty_mounted_pursuit_success" text="You run them down before they reach the treeline." />
    <string id="taom_enlist_duty_mounted_pursuit_title" text="a mounted pursuit" />
    <string id="taom_enlist_duty_night_patrol_body" text="The sergeant needs someone to walk the night rounds before the watch changes." />
    <string id="taom_enlist_duty_night_patrol_failure" text="It didn&apos;t go as planned." />
    <string id="taom_enlist_duty_night_patrol_opta" text="Walk Rounds" />
    <string id="taom_enlist_duty_night_patrol_optb" text="Double Watch" />
    <string id="taom_enlist_duty_night_patrol_success" text="It went well." />
    <string id="taom_enlist_duty_night_patrol_title" text="Night Watch" />
    <string id="taom_enlist_duty_none" text="Nothing for you at present. Stay sharp — that changes." />
    <string id="taom_enlist_duty_pay_delay_body" text="Word spreads that pay is late again, and the men are grumbling." />
    <string id="taom_enlist_duty_pay_delay_failure" text="It didn&apos;t go as planned." />
    <string id="taom_enlist_duty_pay_delay_opta" text="Press Claim" />
    <string id="taom_enlist_duty_pay_delay_optb" text="Wait It Out" />
    <string id="taom_enlist_duty_pay_delay_success" text="It went well." />
    <string id="taom_enlist_duty_pay_delay_title" text="Pay Delayed Again" />
    <string id="taom_enlist_duty_quartermaster_shortage_body" text="The quartermaster is short on supplies and needs a hand sorting it out." />
    <string id="taom_enlist_duty_quartermaster_shortage_failure" text="It didn&apos;t go as planned." />
    <string id="taom_enlist_duty_quartermaster_shortage_opta" text="Stretch Stores" />
    <string id="taom_enlist_duty_quartermaster_shortage_optb" text="Barter Locals" />
    <string id="taom_enlist_duty_quartermaster_shortage_success" text="It went well." />
    <string id="taom_enlist_duty_quartermaster_shortage_title" text="Short on Stores" />
    <string id="taom_enlist_duty_recon_sweep_failure" text="You lose the light before you lose the ground, and come back with little." />
    <string id="taom_enlist_duty_recon_sweep_success" text="You ride the line and come back with the ground mapped." />
    <string id="taom_enlist_duty_recon_sweep_title" text="a reconnaissance sweep" />
    <string id="taom_enlist_duty_recruitment_errand_failure" text="The village has given all the sons it intends to." />
    <string id="taom_enlist_duty_recruitment_errand_success" text="Three names, and two of them can already hold a spear." />
    <string id="taom_enlist_duty_recruitment_errand_title" text="a recruiting errand" />
    <string id="taom_enlist_duty_relief_dispatch_failure" text="You reach them. The news reached them first." />
    <string id="taom_enlist_duty_relief_dispatch_success" text="Word reaches them in time to matter." />
    <string id="taom_enlist_duty_relief_dispatch_title" text="to carry word to a hard-pressed fief" />
    <string id="taom_enlist_duty_result" text="Orders: {DUTY}. {RESULT}" />
    <string id="taom_enlist_duty_road_patrol_failure" text="You ride the road twice and still miss whatever was on it." />
    <string id="taom_enlist_duty_road_patrol_success" text="The road is quiet behind you, and stays quiet." />
    <string id="taom_enlist_duty_road_patrol_title" text="a road patrol" />
    <string id="taom_enlist_duty_scout_route_failure" text="You come back with guesses. The captain wanted certainties." />
    <string id="taom_enlist_duty_scout_route_success" text="The way ahead is clear, and you can say why." />
    <string id="taom_enlist_duty_scout_route_title" text="to scout the road ahead" />
    <string id="taom_enlist_duty_service_shift_failure" text="You are found asleep at your post. It is noted." />
    <string id="taom_enlist_duty_service_shift_success" text="Your shift passes without incident." />
    <string id="taom_enlist_duty_service_shift_title" text="camp duty" />
    <string id="taom_enlist_duty_short_rations_body" text="The stores are thin tonight and there isn&apos;t enough to go around." />
    <string id="taom_enlist_duty_short_rations_failure" text="It didn&apos;t go as planned." />
    <string id="taom_enlist_duty_short_rations_opta" text="Share Yours" />
    <string id="taom_enlist_duty_short_rations_optb" text="Forage Extra" />
    <string id="taom_enlist_duty_short_rations_success" text="It went well." />
    <string id="taom_enlist_duty_short_rations_title" text="Short Rations" />
    <string id="taom_enlist_duty_strategic_planning_body" text="The officers are arguing over the next march and want another voice at the table." />
    <string id="taom_enlist_duty_strategic_planning_failure" text="It didn&apos;t go as planned." />
    <string id="taom_enlist_duty_strategic_planning_opta" text="Draft Route" />
    <string id="taom_enlist_duty_strategic_planning_optb" text="Brief Officers" />
    <string id="taom_enlist_duty_strategic_planning_success" text="It went well." />
    <string id="taom_enlist_duty_strategic_planning_title" text="Plan the Route" />
    <string id="taom_enlist_duty_supply_delivery_failure" text="Half the load is spoiled by the time it is counted." />
    <string id="taom_enlist_duty_supply_delivery_success" text="The wagons are lighter and the stores are fuller." />
    <string id="taom_enlist_duty_supply_delivery_title" text="a supply run" />
    <string id="taom_enlist_duty_train_recruits_body" text="A knot of green recruits stands idle, waiting for someone to put them through their paces." />
    <string id="taom_enlist_duty_train_recruits_failure" text="It didn&apos;t go as planned." />
    <string id="taom_enlist_duty_train_recruits_opta" text="Drill Them" />
    <string id="taom_enlist_duty_train_recruits_optb" text="Spar Lightly" />
    <string id="taom_enlist_duty_train_recruits_success" text="It went well." />
    <string id="taom_enlist_duty_train_recruits_title" text="Drill the Recruits" />
    <string id="taom_enlist_duty_treat_wounded_body" text="Several wounded need attention before the surgeon reaches them all." />
    <string id="taom_enlist_duty_treat_wounded_failure" text="It didn&apos;t go as planned." />
    <string id="taom_enlist_duty_treat_wounded_opta" text="Tend Wounds" />
    <string id="taom_enlist_duty_treat_wounded_optb" text="Fetch Carry" />
    <string id="taom_enlist_duty_treat_wounded_success" text="It went well." />
    <string id="taom_enlist_duty_treat_wounded_title" text="The Wounded Need Tending" />
    <string id="taom_enlist_duty_trusted_dispatch_failure" text="The dispatch arrives late, and you cannot swear it arrived unread." />
    <string id="taom_enlist_duty_trusted_dispatch_success" text="The dispatch is in the right hands, and no others." />
    <string id="taom_enlist_duty_trusted_dispatch_title" text="to carry a dispatch" />
    <string id="taom_enlist_grade_distinguished" text="distinguished" />
    <string id="taom_enlist_grade_rough" text="rough, but you held" />
    <string id="taom_enlist_grade_solid" text="steady" />
    <string id="taom_enlist_grade_strong" text="strong" />
    <string id="taom_enlist_kit_reclaimed" text="The quartermaster takes back your service kit: {COUNT} item(s)." />
    <string id="taom_enlist_leave_refused" text="You cannot take your leave here just now." />
    <string id="taom_enlist_lost_broken_body" text="{COMMANDER}&apos;s company is broken. He lives, but there is no banner left to march with. Hold to your oath and wait for him to raise another, or count your service at an end. If no word comes in {DAYS} days, the oath lapses and you are paid what you are owed." />
    <string id="taom_enlist_lost_captured_body" text="{COMMANDER} was taken on the field. {CAPTOR} hold him in {TOWN}, and the company is scattered. Hold to your oath and wait for word, or count your service at an end. If no word comes in {DAYS} days, the oath lapses and you are paid what you are owed." />
    <string id="taom_enlist_lost_captured_unknown_body" text="{COMMANDER} was taken on the field, and no one can say where he is held. The company is scattered. Hold to your oath and wait for word, or count your service at an end. If no word comes in {DAYS} days, the oath lapses and you are paid what you are owed." />
    <string id="taom_enlist_lost_hold" text="Hold to your oath" />
    <string id="taom_enlist_lost_leave" text="Count your service ended" />
    <string id="taom_enlist_lost_title" text="Word from the column" />
    <string id="taom_enlist_menu_duty" text="Ask your sergeant for work" />
    <string id="taom_enlist_menu_leave" text="Ask to be released from service" />
    <string id="taom_enlist_menu_leave_pass" text="Take leave in the settlement" />
    <string id="taom_enlist_menu_status" text="Review your service" />
    <string id="taom_enlist_menu_talk" text="Speak with your commander" />
    <string id="taom_enlist_merit_toast" text="The sergeants noted your conduct: {GRADE}." />
    <string id="taom_enlist_no_at_war" text="Your kingdom is at war with his. You cannot take his coin and keep your own oath." />
    <string id="taom_enlist_no_generic" text="You cannot enlist under him just now." />
    <string id="taom_enlist_oath_ask" text="Then swear it: your blade at my side, my bread in your pack, until your term is served. Do you swear?" />
    <string id="taom_enlist_oath_decline" text="On second thought — not yet." />
    <string id="taom_enlist_oath_swear" text="I swear it." />
    <string id="taom_enlist_offer" text="I wish to enlist under your command." />
    <string id="taom_enlist_ok" text="Understood" />
    <string id="taom_enlist_promoted" text="You have been promoted to {RANK}." />
    <string id="taom_enlist_qm_issued" text="See the quartermaster&apos;s wagon — your kit is in your baggage." />
    <string id="taom_enlist_qm_refused" text="You have drawn your due for your rank already. Earn the next stripe first." />
    <string id="taom_enlist_qm_request" text="I would draw my service kit from the quartermaster." />
    <string id="taom_enlist_rank_recruit" text="Recruit" />
    <string id="taom_enlist_rank_sergeant" text="Sergeant" />
    <string id="taom_enlist_rank_soldier" text="Soldier" />
    <string id="taom_enlist_rank_veteran" text="Veteran" />
    <string id="taom_enlist_reassign" text="I would take a different place in the line." />
    <string id="taom_enlist_reassign_arc" text="I shoot better than I stab." />
    <string id="taom_enlist_reassign_cav" text="I can ride. Put me with the horsemen." />
    <string id="taom_enlist_reassign_done" text="Report to your new section, then. Don&apos;t make me regret it." />
    <string id="taom_enlist_reassign_inf" text="Put me in the shield line." />
    <string id="taom_enlist_reassign_no_cooldown" text="You changed section too recently. Ask again in {DAYS} days." />
    <string id="taom_enlist_reassign_no_cooldown_one" text="You changed section too recently. Ask again tomorrow." />
    <string id="taom_enlist_reassign_no_generic" text="You cannot change section just now." />
    <string id="taom_enlist_reassign_pick" text="You march with the {CURRENT_SECTION} at present. Where would you rather stand?" />
    <string id="taom_enlist_reassign_sup" text="The baggage and the wounded need hands." />
    <string id="taom_enlist_release_battle" text="Not while there is fighting to be done. Ask me again when the field is quiet." />
    <string id="taom_enlist_release_desert" text="Then I am done with your company. I take my leave, oath or no." />
    <string id="taom_enlist_release_desert_answer" text="Then you are an oathbreaker, and every man here knows it. Get out of my sight." />
    <string id="taom_enlist_release_desert_option" text="Desert the company" />
    <string id="taom_enlist_release_in_battle" text="There is fighting to be done. Ask again once the field is quiet." />
    <string id="taom_enlist_release_refused_body" text="Your commander holds you to your oath — {DAYS} more days are owed. Leaving now is desertion: you forfeit the pay still owed to you, and your commander will not forget it." />
    <string id="taom_enlist_release_refused_title" text="Your term is not served" />
    <string id="taom_enlist_release_relent" text="As you say. I will hold the line." />
    <string id="taom_enlist_release_soon" text="You swore to serve, and {DAYS} days of that oath are still owed. I hold you to it." />
    <string id="taom_enlist_release_stay" text="Stay and serve" />
    <string id="taom_enlist_req_days" text="{COUNT} days of service" />
    <string id="taom_enlist_req_duties" text="{COUNT} duties seen through" />
    <string id="taom_enlist_req_leadership" text="Leadership {COUNT}" />
    <string id="taom_enlist_req_other" text="more service" />
    <string id="taom_enlist_req_trust" text="your commander&apos;s confidence" />
    <string id="taom_enlist_req_xp" text="{COUNT} service XP" />
    <string id="taom_enlist_section_arc" text="bowmen" />
    <string id="taom_enlist_section_cav" text="horse" />
    <string id="taom_enlist_section_inf" text="shield line" />
    <string id="taom_enlist_section_sup" text="baggage train" />
    <string id="taom_enlist_status_body" text="Commander: {COMMANDER}. Enlisted on day {ENLISTED_DAY}; contract ends on day {CONTRACT_END}." />
    <string id="taom_enlist_status_title" text="Service record" />
    <string id="taom_enlist_talk_no_battle" text="Not in the middle of a battle." />
    <string id="taom_enlist_talk_no_commander" text="Your commander cannot be reached." />
    <string id="taom_enlist_talk_no_duty" text="You are away on orders — ride to him yourself." />
    <string id="taom_enlist_talk_no_generic" text="You cannot speak with him just now." />
    <string id="taom_enlist_talk_no_map" text="Not from here." />
    <string id="taom_enlist_term_served" text="Your term of service is complete — you may ask for release with honor, or march on." />
    <string id="taom_enlist_trust_known" text="known" />
    <string id="taom_enlist_trust_new" text="unproven" />
    <string id="taom_enlist_trust_poor" text="badly thought of" />
    <string id="taom_enlist_trust_solid" text="well regarded" />
    <string id="taom_enlist_trust_trusted" text="trusted" />
    <string id="taom_enlist_wage_deferred" text="The paychest is short — {AMOUNT}{GOLD_ICON} of your wages is owed against later." />
    <string id="taom_enlist_wage_forfeited" text="The column can no longer account for {AMOUNT}{GOLD_ICON} of your back pay." />
    <string id="taom_enlist_wage_line" text="Service wages" />
    <string id="taom_enlist_wage_paid" text="Wages received: {AMOUNT}{GOLD_ICON}" />
    <string id="taom_enlist_wait_board_v2" text="{ACTIVITY}{NEWLINE}{NEWLINE}Rank: {RANK} · {SECTION}{NEWLINE}Days served: {DAYS} · Standing: {TRUST}{NEWLINE}Service record: {XP} XP · Daily pay: {WAGE}{COIN}{LADDER}{ARREARS}{DUTY}" />
    <string id="taom_enlist_wait_text" text="You serve in {COMMANDER}&apos;s company. The column moves at your commander&apos;s pace." />
    <string id="taom_enlist_welcome" text="Welcome to the column, soldier. Fall in." />
    <string id="taom_fc_accept" text="Promote" />
    <string id="taom_fc_acknowledge" text="Understood" />
    <string id="taom_fc_cancel" text="Cancel" />
    <string id="taom_fc_confirm_name" text="Confirm" />
    <string id="taom_fc_decline" text="Not Yet" />
    <string id="taom_fc_dismiss" text="Your commission is ended. Return to the ranks." />
    <string id="taom_fc_dismiss_answer" text="Back to the line, then. What I carry goes with the commission; the ranks do not hand it back. You are certain of this?" />
    <string id="taom_fc_dismiss_cancel" text="No. Keep your commission; forget I spoke." />
    <string id="taom_fc_dismiss_confirm" text="I am certain. Return to the {TROOP_NAME} ranks." />
    <string id="taom_fc_dismiss_confirm_body" text="{HERO_NAME} will be discharged and one {TROOP_NAME} added to your party in their place. Everything they carry as a companion is lost with the commission. This cannot be undone." />
    <string id="taom_fc_dismiss_done" text="Then I go back to the line. It was an honor to carry the rank." />
    <string id="taom_fc_dismiss_entry" text="{HERO_NAME} (was {TROOP_NAME})" />
    <string id="taom_fc_dismiss_failed" text="{HERO_NAME} could not be discharged right now." />
    <string id="taom_fc_dismiss_failed_unnamed" text="That companion could not be discharged right now." />
    <string id="taom_fc_dismiss_menu" text="Discharge a promoted companion" />
