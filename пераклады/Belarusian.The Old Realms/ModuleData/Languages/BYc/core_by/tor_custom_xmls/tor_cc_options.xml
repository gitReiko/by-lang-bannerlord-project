<?xml version="1.0" encoding="UTF-8"?>
<base xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" type="string">
 <strings>
  <string id="tor_cc_option1_label_str" text="Імперскай Шляхты"/>
  <string id="tor_cc_option1_text_str" text="Вашыя бацькі верна служылі графу Хаўпт-Андэрсану"/>
  <string id="tor_cc_option2_label_str" text="Імперскага Сяржанта"/>
  <string id="tor_cc_option2_text_str" text="Вашы бацька ня толькі ўдала служыў, але і выжываў досыць доўга, каб атрымаць пасаду Сяржанта"/>
  <string id="tor_cc_option3_label_str" text="Злодзеяў"/>
  <string id="tor_cc_option3_text_str" text="Не ўсе ў Імперыі бласлаўлёныя Ранальдам"/>
  <string id="tor_cc_option4_label_str" text="Простых Людзей"/>
  <string id="tor_cc_option4_text_str" text="Кожны жыхар Імперыі грае сваю ролю. Вы нарадзіліся ў простай сям'і"/>
  <string id="tor_cc_option5_label_str" text="Гандляроў"/>
  <string id="tor_cc_option5_text_str" text="Віно - кроў Вуртбада. Вашая сям'я зарабляла на яго гандлі вышэй па рацэ Шцір і ўсёй Імперыі. Ваша маленства было зьвязана са сталымі вандроўкамі"/>
  <string id="tor_cc_option6_label_str" text="Запісаліся да Рушэньня"/>
  <string id="tor_cc_option6_text_str" text="Зьвералюды і бандыты квітнеюць у Імперыі. Таму вашы дом заўжды меў патрэбу ў дужых людзях"/>
  <string id="tor_cc_option7_label_str" text="{?PLAYER.GENDER}Памагатая{?}Памагаты{\?} Гандляра"/>
  <string id="tor_cc_option7_text_str" text="Гандляр, што праязжаў ля вашай хаты, заўважыў вашыя здольнасьці да лічбаў і ўзяў вас пад сваё крыло"/>
  <string id="tor_cc_option8_label_str" text="{?PLAYER.GENDER}Вучаніца{?}Вучань{\?} Каваля"/>
  <string id="tor_cc_option8_text_str" text="Канфлікты ў Імперыі не спыняліся ні на хвіліну, як і праца яе кавалёў"/>
  <string id="tor_cc_option9_label_str" text="{?PLAYER.GENDER}Імперская Культыстка{?}Імперскі Культыст{\?}"/>
  <string id="tor_cc_option9_text_str" text="Большую частку часу вы бавілі ў храмавым раёне і маліліся розным багам Імперскага Пантэона"/>
  <string id="tor_cc_option10_label_str" text="{?PLAYER.GENDER}Студэнтка-Інжынерка{?}Студэнт-Інжынер{\?}"/>
  <string id="tor_cc_option10_text_str" text="Гісторыі пра Калегіі Нульна заўжды былі вашымі любімымі"/>
  <string id="tor_cc_option11_label_str" text="{?PLAYER.GENDER}Рушэнная{?}Рушэнны{\?} Вольнай Кампаніі"/>
  <string id="tor_cc_option11_effect_str" text="Кар'ера Найміта"/>
  <string id="tor_cc_option11_text_str" text="Біліся і пілі"/>
  <string id="tor_cc_option12_label_str" text="{?PLAYER.GENDER}Вучаніца{?}Вучань{\?} Магістра"/>
  <string id="tor_cc_option12_effect_str" text="Кар'ера Імперскага Магістра"/>
  <string id="tor_cc_option12_text_str" text="Здольнасьці да Вятроў Магіі дазволілі вам заняць месца ў Калегіях Альтдорфа"/>
  <string id="tor_cc_option13_label_str" text="{?PLAYER.GENDER}Акалітка{?}Акаліт{\?} Сьвятара"/>
  <string id="tor_cc_option13_effect_str" text="Кар'ера Сьвятара-Ваяра"/>
  <string id="tor_cc_option13_text_str" text="Вы прысьвяцілі сваё жыцьцё культу свайго бога-заступніка"/>
  <string id="tor_cc_option14_label_str" text="{?PLAYER.GENDER}Ініцыянтка{?}Ініцыянт{\?} Паляўнічага на Вядзьмарак"/>
  <string id="tor_cc_option14_effect_str" text="Кар'ера Паляўнічага на Вядзьмарак"/>
  <string id="tor_cc_option14_text_str" text="Ерась была бізуном добрых людзей Імперыі"/>
  <string id="tor_cc_option15_label_str" text="{?PLAYER.GENDER}Рыцарка-Ініцыянтка{?}Рыцар-Ініцыянт{\?}"/>
  <string id="tor_cc_option15_effect_str" text="Кар'ера Рыцара Старога Сьвета"/>
  <string id="tor_cc_option15_text_str" text="Большасьць шляхціцаў Імперыі не рэкрутуецца ў рэгулярныя войскі"/>
  <string id="tor_cc_option16_label_str" text="Выгнанай Шляхты"/>
  <string id="tor_cc_option16_text_str" text="Амбіцыі загубілі многіх, і вашая сям'я апынулася не ў літасьці свайго Электара"/>
  <string id="tor_cc_option17_label_str" text="Стрыганскіх Караваньнікаў"/>
  <string id="tor_cc_option17_text_str" text="Вы нарадзіліся ў сям'і Стрыганаў. Хтосьці вас цярпеў, але не прымаў ніхто"/>
  <string id="tor_cc_option18_label_str" text="Магільных Грабежнікаў"/>
  <string id="tor_cc_option18_text_str" text="У Сыльваніі маюцца тыя, хто добра плаціць за трупы"/>
  <string id="tor_cc_option19_label_str" text="Рыбакоў"/>
  <string id="tor_cc_option19_text_str" text="На працягу шматлікіх пакаленьняў вашая сям'я лавіла рыбу ў рэках і багнавых лужынах, каб прахарчавацца"/>
  <string id="tor_cc_option20_label_str" text="Сірата"/>
  <string id="tor_cc_option20_text_str" text="Вы ніколі ня ведалі сваю сям'ю, але многія глядзелі на вас са страхам і шапталіся напаўголаску"/>
  <string id="tor_cc_option21_label_str" text="{?PLAYER.GENDER}Памагатая{?}Памагаты{\?} Шляхціча"/>
  <string id="tor_cc_option21_text_str" text="Служба ў палацы фон Карштайнаў дала вам уяўленьне пра побыт вечнажывых"/>
  <string id="tor_cc_option22_label_str" text="{?PLAYER.GENDER}Вучаніца{?}Вучань{\?} Некраманта"/>
  <string id="tor_cc_option22_text_str" text="Пра цьвярозы розум вашага майстара нельга шмат сказаць"/>
  <string id="tor_cc_option23_label_str" text="{?PLAYER.GENDER}Тарфяная Земляробка{?}Тарфяны Земляроб{\?}"/>
  <string id="tor_cc_option23_text_str" text="Капаньне багнавай глебы з бруднымі адкідамі - нялёгкі занятак. Але гэта дазваляла вам і вашай вёсцы зьбіраць бедны ўраджай з прыдатных для земляробства земляў."/>
  <string id="tor_cc_option24_label_str" text="{?PLAYER.GENDER}Заклічніца{?}Заклічнік{\?} Рушэньня"/>
  <string id="tor_cc_option24_text_str" text="Вас заклікалі ў войска свайго валадара"/>
  <string id="tor_cc_option25_label_str" text="{?PLAYER.GENDER}Стрыганская Гайсачка{?}Стрыганскі Гойсак{\?}"/>
  <string id="tor_cc_option25_text_str" text="Гойсаючы па ўскрайкам лагераў, вы падглядвалі лёгкія здабычы і маладых дзяўчын"/>
  <string id="tor_cc_option26_label_str" text="{?PLAYER.GENDER}Вампірка-Шляхцянка{?}Вампір-Шляхціч{\?}"/>
  <string id="tor_cc_option26_effect_str" text="Кар'ера Вампіра"/>
  <string id="tor_cc_option26_text_str" text="У нейкі момант вашы валадар распазнаў вашыя якасьці"/>
  <string id="tor_cc_option27_label_str" text="{?PLAYER.GENDER}Некрамантка-Навік{?}Некрамант-Навік{\?}"/>
  <string id="tor_cc_option27_effect_str" text="Кар'ера Некраманта"/>
  <string id="tor_cc_option27_text_str" text="Нечакана з'явілася магчымасьць скрасьці старажытны фаліянт ведаў"/>
  <string id="tor_cc_option28_label_str" text="{?PLAYER.GENDER}Начная{?}Начны{\?} Дазорца"/>
  <string id="tor_cc_option28_effect_str" text="Кар'ера Найміта"/>
  <string id="tor_cc_option28_text_str" text="Сьмяротных часта заклікаюць служыць сваім мёртвым майстрам. Зразумела, што гэтыя прафесійныя ваяры ідуць у бой разам з процьмай нежыці сваіх майстраў. Больш панурых і забабонных людзей складана сустрэць, але яны рэдка ламаюцца ў запалу бітвы."/>
  <string id="tor_cc_option29_label_str" text="{?PLAYER.GENDER}Стрыганская{?}Стрыганскі{\?} Донму"/>
  <string id="tor_cc_option29_effect_str" text="Кар'ера Найміта"/>
  <string id="tor_cc_option29_text_str" text="While not as influential as the matriarchs of their clan"/>
  <string id="tor_cc_option30_label_str" text="Vagabond"/>
  <string id="tor_cc_option30_effect_str" text="Кар'ера Найміта"/>
  <string id="tor_cc_option30_text_str" text="Дарогі Сыльваніі цёмныя і небясьпечныя"/>
  <string id="tor_cc_option31_label_str" text="Брэтонскай Шляхты"/>
  <string id="tor_cc_option31_text_str" text="Ваша сям'я можа прасачыць свае карані і сувязі амаль да часоў Жыля. Вы — шляхта Брэтоніі. Пра гэта гаворыць усё: манерны гардэроб, вытанчаная мова і прывычка бязьлітасна камандаваць вясковымі"/>
  <string id="tor_cc_option32_label_str" text="Брэтонскіх Прыгонных"/>
  <string id="tor_cc_option32_text_str" text="На працягу шматлікіх пакаленьняў"/>
  <string id="tor_cc_option33_label_str" text="Брэтонскіх Маракоў"/>
  <string id="tor_cc_option33_text_str" text="Вашы бацька быў мараком на Брэтонскім Буканьеры. Пасьля вяртаньня ў вашую рыбацкую вёску"/>
  <string id="tor_cc_option34_label_str" text="Злачынцаў"/>
  <string id="tor_cc_option34_text_str" text="Чамусьці"/>
  <string id="tor_cc_option35_label_str" text="Вінных Гандляроў"/>
  <string id="tor_cc_option35_text_str" text="Вашая сям'я належала да вельмі абмежаванага кола вяскоўцаў, што жыве ў Брэтоніі. Яны нажывалі сваё багацьце на працягу шматлікіх пакаленьняў праз продаж Брэтонскіх вінаў у Імперыю"/>
  <string id="tor_cc_option36_label_str" text="{?PLAYER.GENDER}Брэтонская Палацавая{?}Брэтонскі Палацавы{\?}"/>
  <string id="tor_cc_option36_text_str" text="Цягам шматлікіх гадоў"/>
  <string id="tor_cc_option37_label_str" text="Збройны Чын"/>
  <string id="tor_cc_option37_text_str" text="Калі вы дасягнулі паўналецьця"/>
  <string id="tor_cc_option38_label_str" text="Злачынца ў Вышуку"/>
  <string id="tor_cc_option38_text_str" text="У маладзёнстве вы парушылі адзін са шматлікіх законаў"/>
  <string id="tor_cc_option39_label_str" text="{?PLAYER.GENDER}Вучаніца{?}Вучань{\?} Рамесьніка"/>
  <string id="tor_cc_option39_text_str" text="Вашы бацька змог уладкаваць вас у вучні да аднаго з мясцовых рамесьнікаў. Цягам пяці гадоў майстар вучыў вас усяму, што меў, і ў выніку вы набылі навыкі"/>
  <string id="tor_cc_option40_label_str" text="{?PLAYER.GENDER}Шэпардка{?}Шэпард{\?}"/>
  <string id="tor_cc_option40_text_str" text="Вы сталі пастухом"/>
  <string id="tor_cc_option41_label_str" text="{?PLAYER.GENDER}Вандроўная Рыцарка{?}Вандроўны Рыцар{\?}"/>
  <string id="tor_cc_option41_effect_str" text="Кар'ера Брэтонскага Рыцара"/>
  <string id="tor_cc_option41_text_str" text="Вы вырашылі стаць на шлях рыцара Брэтоніі. Дарога шляхетнага рыцарства цяжкая - вас чакае мноства ворагаў і бітваў. Але"/>
  <string id="tor_cc_option42_label_str" text="Цнатліўка Лэдзі"/>
  <string id="tor_cc_option42_effect_str" text="Кар'ера Цнатліўкі Лэдзі"/>
  <string id="tor_cc_option42_text_str" text="Напачатку вашага жыцьця"/>
  <string id="tor_cc_option43_label_str" text="{?PLAYER.GENDER}Ёмэнка-Наглядніца{?}Ёмэн-Нагляднік{\?}"/>
  <string id="tor_cc_option43_effect_str" text="Кар'ера Найміта"/>
  <string id="tor_cc_option43_text_str" text="Вы давялі свайму шляхцічу сваю вартасьць, і ён узнагародзіў вас тытулам Ёмэна. З гэтага часу"/>
  <string id="tor_cc_option44_label_str" text="Freeman"/>
  <string id="tor_cc_option44_effect_str" text="Кар'ера Найміта"/>
  <string id="tor_cc_option44_text_str" text="With licence of movement and a sense to improve yourself"/>
  <string id="tor_cc_option45_label_str" text="Wall Warden"/>
  <string id="tor_cc_option45_effect_str" text="Кар'ера Найміта"/>
  <string id="tor_cc_option45_text_str" text="You were the apprentice of a Wall Warden for some time. You helped him evaluate damage and maintain the castle of your lord. When your master was killed during an assault on the castle walls"/>
  <string id="tor_cc_option46_label_str" text="Mousillan Nobility"/>
  <string id="tor_cc_option46_text_str" text="You parents were of the ‘Nobility’ in Mousillon"/>
  <string id="tor_cc_option47_label_str" text="Mousillan Yeoman"/>
  <string id="tor_cc_option47_text_str" text="Your father was a Yeoman for one of the lords in the cursed dukedom. His position was one of the few that ensured your family dry lodgings and decent food"/>
  <string id="tor_cc_option48_label_str" text="Bog Smuggler"/>
  <string id="tor_cc_option48_text_str" text="Trade in and out of Mousillon is nearly impossible due to the Cordon Sanitaire. Despite this"/>
  <string id="tor_cc_option49_label_str" text="Peat Farmer and his Frogwife"/>
  <string id="tor_cc_option49_text_str" text="Somehow"/>
  <string id="tor_cc_option50_label_str" text="Outlaws"/>
  <string id="tor_cc_option50_text_str" text="One of the most common professions of Mousillon"/>
  <string id="tor_cc_option51_label_str" text="Mousillan Courtier"/>
  <string id="tor_cc_option51_text_str" text="For years"/>
  <string id="tor_cc_option52_label_str" text="Student of Witchcraft"/>
  <string id="tor_cc_option52_text_str" text="Witchcraft and Magic is rife in Mousillon. You became a student of one of these practitioners and worked on brews and potions until you were trusted to learn more arcane knowledge."/>
  <string id="tor_cc_option53_label_str" text="Mousillan Man-at-Arms"/>
  <string id="tor_cc_option53_text_str" text="When you came of age"/>
  <string id="tor_cc_option54_label_str" text="Swampaire"/>
  <string id="tor_cc_option54_text_str" text="You spent your time hunting frogs and snails in the swamps and bogs to support your family. It is a tricky task that requires some skill and quickness to your fingers but snails and frogs are one of the few resources that your land is rich in."/>
  <string id="tor_cc_option55_label_str" text="Brigand"/>
  <string id="tor_cc_option55_text_str" text="Waiting along the high roads and near ferries"/>
  <string id="tor_cc_option56_label_str" text="Mousillan Errant Knight"/>
  <string id="tor_cc_option56_effect_str" text="Knight of Mousillon Career"/>
  <string id="tor_cc_option56_text_str" text="Nothing says that a man of Mousillon cannot walk the path of a Bretonnian Knight. Where that path leads is as always reliant on the will and purity of the individual who walks it."/>
  <string id="tor_cc_option57_label_str" text="Vampire of Mousillon"/>
  <string id="tor_cc_option57_effect_str" text="Vampire Career"/>
  <string id="tor_cc_option57_text_str" text="The swamps prevent the land of chivalry from exerting their control over the cursed dukedom"/>
  <string id="tor_cc_option58_label_str" text="Necromancer"/>
  <string id="tor_cc_option58_effect_str" text="Necromancer Career"/>
  <string id="tor_cc_option58_text_str" text="Witches and Warlocks"/>
  <string id="tor_cc_option59_label_str" text="Cordon Runner"/>
  <string id="tor_cc_option59_effect_str" text="Кар'ера Найміта"/>
  <string id="tor_cc_option59_text_str" text="Things arrive in Mousillon that would be confiscated in any other port of the Oldworld. Wyrdstone"/>
  <string id="tor_cc_option60_label_str" text="Bog Pirate"/>
  <string id="tor_cc_option60_effect_str" text="Кар'ера Найміта"/>
  <string id="tor_cc_option60_text_str" text="The Foggy river heads and boggy bays of Mousillon make great hideouts for those of a less than legitimate profession. Bretonnian vessels are some of the best in the world"/>
  <string id="tor_cc_option_1_daith_label_str" text="Student of Daith"/>
  <string id="tor_cc_option_1_daith_text_str" text="You were taken under the wing of Daith"/>
  <string id="tor_cc_option_1_we_forest_label_str" text="Survivor of the Forest"/>
  <string id="tor_cc_option_1_we_forest_text_str" text="You were raised by the forest. It took decades"/>
  <string id="tor_cc_option_1_we_mountain_label_str" text="Veteran of Mountain Conflicts"/>
  <string id="tor_cc_option_1_we_mountain_text_str" text="You have faced the hardy Dwarfs in numerous skirmishes in the Grey Mountains surrounding Athel Loren. Your experiences in these rugged battles have honed your skills and resilience"/>
  <string id="tor_cc_option_1_we_noble_label_str" text="Minor Noble of Athel Loren"/>
  <string id="tor_cc_option_1_we_noble_text_str" text="Born into a minor noble family of Athel Loren's halls"/>
  <string id="tor_option_1_we_guardian_anmyr_label_str" text="Guardian of Anmyr"/>
  <string id="tor_option_1_we_guardian_anmyr_text_str" text="Anmyr"/>
  <string id="tor_cc_option_2_we_kurnous_label_str" text="Kurnous"/>
  <string id="tor_cc_option_2_we_kurnous_effect_str" text="Unlocks Kithband Symbol"/>
  <string id="tor_option_2_we_kurnous_text_str" text="The god of the hunt and wild realms in the Elven Pantheon. All Elves revere him but Kurnous is dearest to the Wood Elves"/>
  <string id="tor_cc_option_2_we_isha_effect_str" text="Unlocks Treekin Symbol"/>
  <string id="tor_cc_option_2_we_isha_label_str" text="Isha"/>
  <string id="tor_cc_option_2_we_isha_text_str" text="The Elven goddess of nature"/>
  <string id="tor_cc_option_2_we_loec_effect_str" text="Unlocks Wardancer Symbol"/>
  <string id="tor_cc_option_2_we_loec_label_str" text="Loec"/>
  <string id="tor_cc_option_2_we_loec_text_str" text="The god of trickery"/>
  <string id="tor_cc_option_2_we_vaul_label_str" text="Vaul"/>
  <string id="tor_cc_option_2_we_vaul_effect_str" text="Unlocks Kithband Symbol"/>
  <string id="tor_cc_option_2_we_vaul_text_str" text="The Elven god of smiths"/>
  <string id="tor_cc_option_2_we_anath_raema_effect_str" text="Unlocks Kithband Symbol"/>
  <string id="tor_cc_option_2_we_anath_raema_label_str" text="Anath Raema"/>
  <string id="tor_cc_option_2_we_anath_raema_text_str" text="Anath Raema"/>
  <string id="tor_cc_option_3_we_wardancer_label_str" text="Path of the Wardancer"/>
  <string id="tor_cc_option_3_we_wardancer_effect_str" text="Glade Lord Career"/>
  <string id="tor_cc_option_3_we_wardancer_text_str" text="You are a warrior"/>
  <string id="tor_cc_option_3_we_waywatcher_label_str" text="Path of the Waywatcher"/>
  <string id="tor_cc_option_3_we_waywatcher_effect_str" text="Waywatcher Career"/>
  <string id="tor_cc_option_3_we_waywatcher_text_str" text="You are a seasoned scout"/>
  <string id="tor_cc_option_3_we_spellsinger_label_str" text="Path of the Spellsinger"/>
  <string id="tor_cc_option_3_we_spellsinger_effect_str" text="Spellsinger Career"/>
  <string id="tor_cc_option_3_we_spellsinger_text_str" text="You are a spellsinger"/>
