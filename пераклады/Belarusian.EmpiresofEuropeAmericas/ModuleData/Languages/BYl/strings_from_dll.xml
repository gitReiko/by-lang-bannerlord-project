    <!-- {=!}Reason for Adventuring -->
    <!-- {=!}You started adventuring... -->
    <string id="CCR_Reason_travel" text="kab pabačyć śviet" />
    <string id="CCR_Reason_desc_travel" text="Vy nie zmahli vystajać pierad spakusaj padarožžaŭ, bo zaŭždy maryli pabačyć śviet." />
    <string id="CCR_Reason_revenge" text="kab adpomścić" />
    <string id="CCR_Reason_desc_revenge" text="Zaznaŭšy kryŭdu, vy adčuli patrebu adpomścić. Z hetaj metaj vy błukali pa Kalradyi, šukajučy adpłaty." />
    <string id="CCR_Reason_forced_out" text="paśla vyhnańnia z domu" />
    <string id="CCR_Reason_desc_forced_out" text="Paśla čarhovaj svarki baćki vyhnali vas z domu. Iści nie było kudy, i vam zastavałasia tolki šukać pryhodaŭ." />
    <string id="CCR_Reason_money" text="u pošukach hrošaj" />
    <string id="CCR_Reason_desc_money" text="Vy zaŭsiody chacieli razbahacieć i dobra razumieli, što, zastaŭšysia doma, nikoli hetaha nie dasiahniecie." />
    <string id="CCR_Reason_power" text="kab stać {?PLAYER.GENDER}haspadaryniaj{?}haspadarom{\?}" />
    <string id="CCR_Reason_desc_power" text="Pabačyŭšy, kolki pieravahaŭ majuć uładary, vy vypravilisia nasustrač pryhodam, kab dałučycca da ich ci navat zaniać ichnaje miesca." />
    <string id="CCR_Reason_history" text="kab pakinuć śled u historyi" />
    <string id="CCR_Reason_desc_history" text="Bieśpierapynnyja vojny ŭ Kalradyi dajuć šmat mahčymaściaŭ upisać {?PLAYER.GENDER}svajo{?}svajo{\?} imia ŭ historyju." />
    <string id="CCR_Reason_loss" text="paśla straty blizkaha čałavieka" />
    <string id="CCR_Reason_desc_loss" text="Straciŭšy blizkaha čałavieka, vy vypravilisia ŭ darohu ŭ nadziei zapoŭnić hetuju pusteču." />
    <string id="CCR_Reason_crafting" text="kab udaskanalić svajo ramiastvo" />
    <string id="CCR_Reason_desc_crafting" text="Ramiastvo było važnaj častkaj vašaha žyćcia, ale majsterstva vam brakavała. Tamu vy vyrašyli vypravicca ŭ padarožža, kab udaskanalić jaho." />
    <string id="CCR_Reason_helping" text="kab dapamahać tym, chto maje patrebu" />
    <string id="CCR_Reason_desc_helping" text="Navučyŭšysia lačyć, vy vyrašyli vypravicca ŭ darohu j dapamahać tym, chto maje patrebu, bo vojny prynieśli pakuty mnohim." />
    <string id="CCR_Reason_prove_worth" text="kab davieści svajo bajavoje majsterstva" />
    <string id="CCR_Reason_desc_prove_worth" text="Vy vysoka canili svajo bajavoje majsterstva i vyrašyli, što niama lepšaha miesca za Kalradyju, kab davieści svaju moc." />
    <string id="HDFEAYDk" text="Pačatkovy Ŭzrost" />
    <string id="VlOGrGSn" text="Vaš piersanaž staŭ na šlach pryhodaŭ va ŭzroście..." />
    <!-- {=!}21 -->
    <string id="2k7adlh7" text="Vam trochi brakuje dośviedu, ale vy poŭnyja junackaj enierhii i całkam hatovyja da doŭhich hadoŭ pryhodaŭ." />
    <!-- {=!}30 -->
    <string id="NUlVFRtK" text="Vy ŭ roskvicie siłaŭ: jašče zachoŭvajecie junackuju enerhiju, ale ŭžo majecie za plačami značny dośvied. " />
    <!-- {=!}40 -->
    <string id="5MxTYApM" text="Heta prydatny viek dla pačatku: vy majecie šmathadovy dośvied i ŭžo dosyć stałyja, kab ludzi pavažali vas i źbiralisia pad vašym ściaham." />
    <!-- {=!}50 -->
    <string id="ePD5Afvy" text="Choć roskvit siłaŭ užo minuŭ, jašče jość čas na apošniuju vialikuju pryhodu. I vy majecie ŭvieś patrebny dośvied, kab pieraadoleć lubyja pieraškody!" />

