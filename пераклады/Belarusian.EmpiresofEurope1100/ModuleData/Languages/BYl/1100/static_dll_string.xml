  <string id="CCR_Reason_travel" text="kab pabačyć śviet."/>
  <string id="CCR_Reason_desc_travel" text="Spakusa vandravać była niepieraadolnaj, bo vy zaŭsiody maryli pabačyć śviet."/>
  <string id="CCR_Reason_revenge" text="kab adpomścić."/>
  <string id="CCR_Reason_desc_revenge" text="Paśla ŭčynienaj vam kryŭdy vy prahnuli pomsty. Z hetaj metaj vy błukali pa Kalradyi, damahajučysia adpłaty."/>
  <string id="CCR_Reason_forced_out" text="paśla taho, jak vas vyhnali z domu."/>
  <string id="CCR_Reason_desc_forced_out" text="Paśla apošniaj svarki baćki vyhnali vas z domu. Iści nie było kudy, tamu zastavałasia tolki šukać pryhodaŭ."/>
  <string id="CCR_Reason_money" text="u pošukach bahaćcia"/>
  <string id="CCR_Reason_desc_money" text="Vy zaŭsiody chacieli razbahacieć i dobra razumieli, što, zastajučysia doma, nikoli nia ździejśnicie hetuju maru."/>
  <string id="CCR_Reason_power" text="kab stać haspadarom"/>
  <string id="CCR_Reason_desc_power" text="Vy bačyli, kolki pieravahaŭ majuć uładary, i vypravilisia ŭ pryhody, kab dałučycca da ich ci navat zaniać ichnaje miesca."/>
  <string id="CCR_Reason_history" text="kab pakinuć śled u historyi"/>
  <string id="CCR_Reason_desc_history" text="Vojny ŭ Kalradyi davali šmat mahčymaściaŭ upisać {?PLAYER.GENDER}svajo{?}svajo{\?} imia ŭ historyju."/>
  <string id="CCR_Reason_loss" text="paśla straty blizkaha čałavieka"/>
  <string id="CCR_Reason_desc_loss" text="Paśla straty blizkaha čałavieka vy vypravilisia ŭ šlach u nadziei zapoŭnić pusteču ŭ dušy"/>
  <string id="CCR_Reason_crafting" text="kab udaskanalić svajo ramiastvo"/>
  <string id="CCR_Reason_desc_crafting" text="Ramiastvo było važnaju častkaju vašaha žyćcia, ale vam brakavała majsterstva. Tamu vy vyrašyli vypravicca ŭ padarožža, kab jaho ŭdaskanalić."/>
  <string id="CCR_Reason_helping" text="kab dapamahčy tym, chto ŭ niastačy"/>
  <string id="CCR_Reason_desc_helping" text="Navučyŭšysia lekarskamu majsterstvu, vy vyrašyli vypravicca ŭ śviet i dapamahać tym, chto ŭ niastačy, bo vojny prynieśli šmat pakutaŭ."/>
  <string id="CCR_Reason_prove_worth" text="kab davieści svajo bajavoje majsterstva"/>
  <string id="CCR_Reason_desc_prove_worth" text="Vy vielmi canili svajo bajavoje majsterstva i ličyli, što niama lepšaha miesca za Kalradyju, kab pakazać svaju moc."/>
  <string id="HDFEAYDk" text="Pačatkovy Ŭzrost"/>
  <string id="VlOGrGSn" text="Vaš piersanaž staŭ na šlach pryhodaŭ va ŭzroście..."/>
  <string id="2k7adlh7" text="Vam trochi brakuje dośviedu, ale vy poŭnyja junackaj enerhii i ź nieciarpieńniem čakajecie doŭhich hadoŭ pryhodaŭ."/>
  <string id="NUlVFRtK" text="Vy ŭ roskvicie siłaŭ: jašče zachoŭvajecie junackuju enerhiju, ale ŭžo majecie za plačyma značny dośvied. "/>
  <string id="5MxTYApM" text="Heta dobry ŭzrost dla pačatku: vy majecie šmathadovy dośvied i ŭžo dosyć stałyja, kab ludzi pavažali vas i źbiralisia pad vašym ściaham."/>
  <string id="ePD5Afvy" text="Choć roskvit vašych siłaŭ užo minuŭ, času na apošniuju vialikuju pryhodu jašče chapaje. A vaš dośvied dazvolić pieraadoleć lubyja pieraškody!"/>
  <string id="RClxLG6N" text="Čakaje."/>
